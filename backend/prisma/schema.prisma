// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole  @default(CLIENT)
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  businesses    Business[]
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]

  @@map("users")
}

model Business {
  id              String    @id @default(uuid())
  name            String
  description     String?
  email           String
  phone           String
  address         String?
  city            String?
  country         String?
  logo            String?
  coverImage      String?
  website         String?
  timezone        String    @default("Europe/Bratislava")
  currency        String    @default("EUR")
  averageRating   Float     @default(0)
  totalReviews    Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services        Service[]
  staff           Staff[]
  workingHours    WorkingHours[]
  bookings        Booking[]
  reviews         Review[]

  @@map("businesses")
}

model Service {
  id          String    @id @default(uuid())
  name        String
  description String?
  duration    Int       // in minutes
  price       Float
  currency    String    @default("EUR")
  isActive    Boolean   @default(true)
  color       String?   // for calendar display
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  staffServices StaffService[]

  @@map("services")
}

model Staff {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?
  avatar      String?
  title       String?   // e.g., "Senior Stylist"
  bio         String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  staffServices StaffService[]
  workingHours WorkingHours[]

  @@map("staff")
}

model StaffService {
  id         String   @id @default(uuid())
  staffId    String
  serviceId  String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@map("staff_services")
}

model WorkingHours {
  id          String    @id @default(uuid())
  dayOfWeek   DayOfWeek
  startTime   String    // HH:mm format
  endTime     String    // HH:mm format
  isActive    Boolean   @default(true)

  // Relations - can be for business or specific staff
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffId     String?
  staff       Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("working_hours")
}

model Booking {
  id              String        @id @default(uuid())
  startTime       DateTime
  endTime         DateTime
  status          BookingStatus @default(PENDING)
  totalPrice      Float
  currency        String        @default("EUR")
  notes           String?
  cancelReason    String?
  reminderSent    Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  clientId        String
  client          User          @relation(fields: [clientId], references: [id])
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  staffId         String?
  staff           Staff?        @relation(fields: [staffId], references: [id])
  review          Review?

  @@index([clientId])
  @@index([businessId])
  @@index([startTime])
  @@map("bookings")
}

model Review {
  id          String    @id @default(uuid())
  rating      Int       // 1-5
  comment     String?
  response    String?   // Business owner response
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId    String
  client      User      @relation(fields: [clientId], references: [id])
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id          String    @id @default(uuid())
  title       String
  message     String
  type        String    // 'booking', 'reminder', 'review', etc.
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}
